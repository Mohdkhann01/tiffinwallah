# Copy to .env and set real values. Never commit server/.env.
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=<generate-a-random-secret-at-least-32-characters>
ADMIN_EMAIL=<existing-admin-email>
ADMIN_PASSWORD=<strong-admin-password-at-least-12-characters>
DELIVERY_PARTNER_ID=TWDEL001
DELIVERY_PARTNER_PASSWORD=<strong-delivery-password-at-least-12-characters>
CLIENT_URL=https://tiffinwallah.vercel.app
PUBLIC_APP_URL=https://tiffinwallah.vercel.app
ALLOWED_ORIGINS=https://tiffinwallah.vercel.app,https://www.tiffinwallah.in
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>
# Optional email settings
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
